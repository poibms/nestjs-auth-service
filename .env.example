DATABASE_URL="postgresql://postgres:postgres@localhost:5434/auth_service?schema=public"
BCRYPT_ROUNDS=12

# Email confirmation on registration: true | false (default: false)
REGISTRATION_CONFIRMATION_ENABLED=false
# Confirmation method: otp | magic_link (default: otp)
REGISTRATION_CONFIRMATION_METHOD=otp
# CONFIRMATION_HMAC_SECRET and REGISTRATION_CONFIRM_URL are always required:
# confirm/resend of already issued attempts work regardless of the current
# REGISTRATION_CONFIRMATION_ENABLED / REGISTRATION_CONFIRMATION_METHOD.

# Required, min 32 chars. Generate: openssl rand -base64 32
# CONFIRMATION_HMAC_SECRET=
# Required. Frontend page that reads ?token= and sends POST /auth/register/confirm { token }
# (not an API URL: links are opened with GET, activation is POST only).
REGISTRATION_CONFIRM_URL="http://localhost:5173/confirm-email"

# SMTP for outgoing mail. Locally: Mailpit from docker-compose (web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="no-reply@auth-service.local"

# Rate limit per IP for POST /auth/register and POST /auth/register/resend
# (separate counter per endpoint): at most AUTH_RATE_LIMIT requests per AUTH_RATE_TTL_MS.
# AUTH_RATE_TTL_MS is in milliseconds (default: 60000 = 1 min). AUTH_RATE_LIMIT default: 10.
AUTH_RATE_TTL_MS=60000
AUTH_RATE_LIMIT=10
