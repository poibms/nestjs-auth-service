DATABASE_URL="postgresql://postgres:postgres@localhost:5434/auth_service?schema=public"
BCRYPT_ROUNDS=12

# Email confirmation on registration: true | false (default: false)
REGISTRATION_CONFIRMATION_ENABLED=false
# Confirmation method: otp | magic_link (default: otp)
REGISTRATION_CONFIRMATION_METHOD=otp
# Required when REGISTRATION_CONFIRMATION_ENABLED=true, min 32 chars.
# Generate: openssl rand -base64 32
# CONFIRMATION_HMAC_SECRET=
# Required when REGISTRATION_CONFIRMATION_METHOD=magic_link.
# Frontend page that reads ?token= and sends POST /auth/register/confirm { token }
# (not an API URL: links are opened with GET, activation is POST only).
REGISTRATION_CONFIRM_URL="http://localhost:5173/confirm-email"

# SMTP for outgoing mail. Locally: Mailpit from docker-compose (web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="no-reply@auth-service.local"
